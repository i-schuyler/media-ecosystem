{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-ecosystem.invalid/schema/android-platform-proof-evidence-v1.1.json",
  "title": "Disposable Android platform proof evidence 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_app",
    "environment",
    "fixture_manifest_sha256",
    "format_contract",
    "session_timing",
    "storage",
    "playback",
    "screen_off_workflow",
    "format_matrix",
    "physical_actions",
    "errors",
    "cleanup",
    "export_handoff",
    "export"
  ],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "proof_app": {
      "type": "object",
      "required": ["version", "source_commit", "build_variant", "dependencies"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "source_commit": { "type": "string" },
        "build_variant": { "type": "string" },
        "dependencies": { "type": "object" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["android_release", "android_build", "device_model", "architecture"],
      "additionalProperties": false,
      "properties": {
        "android_release": { "type": "string" },
        "android_build": { "type": "string" },
        "device_model": { "type": "string" },
        "architecture": { "type": "string" }
      }
    },
    "fixture_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "format_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "active_required_count",
        "active_required_format_ids",
        "historical_nonrequired_format_ids"
      ],
      "properties": {
        "id": { "const": "v1-required-formats-2026-07-28" },
        "active_required_count": { "const": 6 },
        "active_required_format_ids": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["mp3-v0", "mp3-320", "flac", "aac", "ogg-vorbis", "wav"]
          }
        },
        "historical_nonrequired_format_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["alac", "aiff"] }
        }
      }
    },
    "session_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_wall_time_utc",
        "started_elapsed_realtime_ms",
        "ended_wall_time_utc",
        "ended_elapsed_realtime_ms",
        "total_monotonic_duration_ms"
      ],
      "properties": {
        "started_wall_time_utc": { "type": "string" },
        "started_elapsed_realtime_ms": { "type": "integer", "minimum": 0 },
        "ended_wall_time_utc": { "type": "string" },
        "ended_elapsed_realtime_ms": { "type": "integer", "minimum": 0 },
        "total_monotonic_duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "storage": { "type": "object" },
    "playback": { "type": "object" },
    "screen_off_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "test_started",
        "playback_continued_while_screen_off",
        "minimum_duration_reached",
        "controls_exercised",
        "test_completed",
        "required_duration_ms",
        "monotonic_duration_ms"
      ],
      "properties": {
        "phase": {
          "enum": [
            "NOT_STARTED",
            "TEST_STARTED",
            "READY_TO_TURN_SCREEN_OFF",
            "SCREEN_OFF_PLAYING",
            "MINIMUM_REACHED",
            "INCOMPLETE",
            "COMPLETED"
          ]
        },
        "test_started": { "type": "boolean" },
        "playback_continued_while_screen_off": { "type": "boolean" },
        "minimum_duration_reached": { "type": "boolean" },
        "controls_exercised": { "type": "boolean" },
        "test_completed": { "type": "boolean" },
        "required_duration_ms": { "const": 300000 },
        "monotonic_duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "format_matrix": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["fixture_id", "disposition"],
        "properties": {
          "fixture_id": {
            "enum": ["mp3-v0", "mp3-320", "flac", "aac", "ogg-vorbis", "wav"]
          },
          "disposition": {
            "enum": ["passed", "failed", "inconclusive", "not run"]
          }
        }
      }
    },
    "physical_actions": { "type": "array" },
    "errors": { "type": "array" },
    "cleanup": { "type": "object" },
    "export_handoff": {
      "type": "object",
      "required": [
        "status",
        "raw_destination_uri_exported",
        "personal_path_exported"
      ],
      "properties": {
        "status": { "type": "string" },
        "provider_category": { "type": "string" },
        "suggested_filename": { "type": "string" },
        "returned_name_matched_proof_pattern": { "type": "boolean" },
        "raw_destination_uri_exported": { "const": false },
        "personal_path_exported": { "const": false }
      }
    },
    "export": {
      "type": "object",
      "required": [
        "generated_wall_time_utc",
        "generated_elapsed_realtime_ms",
        "privacy"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_wall_time_utc": { "type": "string" },
        "generated_elapsed_realtime_ms": { "type": "integer", "minimum": 0 },
        "privacy": { "type": "string" }
      }
    }
  }
}
